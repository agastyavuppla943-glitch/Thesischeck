# Optional: enable live fundamentals data via Financial Modeling Prep.
# Without this, ThesisCheck uses deterministic simulated fundamentals.
FMP_API_KEY=

# Optional: enable live sentiment data via NewsAPI.
# Without this, ThesisCheck uses deterministic simulated sentiment.
NEWSAPI_KEY=

# Optional: require an authenticated ExecutionContext (e.g. via ApiKeyModule
# or JWTModule) before the advisory tool will run. Defaults to false.
THESISCHECK_REQUIRE_AUTH=false
